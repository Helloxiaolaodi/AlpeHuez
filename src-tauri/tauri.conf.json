{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlpeHuez",
  "mainBinaryName": "AlpeHuez",
  "version": "0.7.0",
  "identifier": "com.yanglun.my-nav-panel",
  "build": {
    "frontendDist": "../panel"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AlpeHuez",
        "url": "http://nav.localhost/index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwOERCN0JFQzEwMTQ4NEQKUldSTlNBSEJ2cmVOc0xVRmxJZS9rL3BHTThLNC9wVVZVSDVBYTByNjlYUzU1TGc4dmlkcE83aTIK",
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/Helloxiaolaodi/AlpeHuez@main/releases/updater-latest.json",
        "https://raw.githubusercontent.com/Helloxiaolaodi/AlpeHuez/main/releases/updater-latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
