{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlpeHuez",
  "version": "0.4.0",
  "identifier": "com.yanglun.my-nav-panel",
  "build": {
    "frontendDist": "../panel"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AlpeHuez",
        "url": "http://nav.localhost/index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
