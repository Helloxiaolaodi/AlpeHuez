{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "nav-site",
  "description": "nav:// 网站窗口（Remote origin）的能力：打开开发者面板、用系统浏览器打开外链",
  "windows": ["main", "preview"],
  "remote": {
    "urls": ["http://nav.localhost/*"]
  },
  "permissions": [
    "core:default",
    "allow-open-dev-panel",
    "allow-open-url",
    "allow-open-url-scheme",
    "allow-open-internal-page",
    "allow-activate-internal-page",
    "allow-layout-internal-pages",
    "allow-focus-internal-page",
    "allow-close-internal-page",
    "allow-get-app-version",
    "allow-list-internal-pages",
    "allow-read-json",
    "allow-write-json",
    "allow-read-software",
    "allow-write-software",
    "allow-create-folder",
    "allow-git-status",
    "allow-git-log",
    "allow-git-push",
    "allow-sys-stats",
    "allow-run-script",
    "allow-verify-password",
    "allow-change-password",
    "allow-save-bg-image",
    "allow-get-bg-config",
    "allow-set-bg-config",
    "allow-save-feedback",
    "allow-get-feedback",
    "allow-get-wechat-qr",
    "allow-list-browsers",
    "allow-get-browser-config",
    "allow-set-browser-config",
    "allow-list-workspaces",
    "allow-get-active-workspace",
    "allow-set-active-workspace",
    "allow-create-workspace",
    "allow-update-workspace",
    "allow-delete-workspace",
    "allow-get-workspace-links",
    "allow-save-workspace-links",
    "allow-get-app-config",
    "allow-set-app-config"
  ]
}
