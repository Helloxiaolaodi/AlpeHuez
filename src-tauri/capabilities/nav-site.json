{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "nav-site",
  "description": "nav:// 网站窗口（Remote origin）的能力：打开开发者面板、用系统浏览器打开外链",
  "windows": ["main", "preview"],
  "remote": {
    "urls": ["http://nav.localhost/*"]
  },
  "permissions": [
    "core:default",
    "allow-open-dev-panel",
    "allow-open-url",
    "allow-open-url-scheme",
    "allow-read-clipboard",
    "allow-open-internal-page",
    "allow-activate-internal-page",
    "allow-layout-internal-pages",
    "allow-focus-internal-page",
    "allow-close-internal-page",
    "allow-go-back-internal-page",
    "allow-go-forward-internal-page",
    "allow-reload-internal-page",
    "allow-get-app-version",
    "allow-list-internal-pages",
    "allow-set-internal-page-visible",
    "allow-discard-internal-page",
    "allow-mark-first-run",
    "allow-read-json",
    "allow-write-json",
    "allow-read-software",
    "allow-write-software",
    "allow-create-folder",
    "allow-git-status",
    "allow-git-log",
    "allow-git-push",
    "allow-sys-stats",
    "allow-run-script",
    "allow-verify-password",
    "allow-change-password",
    "allow-save-bg-image",
    "allow-get-bg-config",
    "allow-set-bg-config",
    "allow-send-feedback-email",
    "allow-get-wechat-qr",
    "allow-get-browser-config",
    "allow-list-workspaces",
    "allow-get-active-workspace",
    "allow-set-active-workspace",
    "allow-create-workspace",
    "allow-update-workspace",
    "allow-delete-workspace",
    "allow-get-workspace-links",
    "allow-save-workspace-links",
    "allow-get-app-config",
    "allow-set-app-config",
    "allow-hf-backup",
    "allow-backup-history",
    "allow-hf-test-connection",
    "allow-webdav-backup",
    "allow-webdav-test-connection",
    "allow-set-webdav-password",
    "allow-webdav-password-set",
    "allow-backup-set-local-state",
    "allow-restore-backup",
    "allow-save-daily-note",
    "allow-list-daily-notes",
    "allow-delete-daily-note",
    "allow-save-bookmarks-export",
    "allow-hide-main-window",
    "allow-launch-note-app",
    "allow-pick-folder",
    "allow-pick-note-app",
    "allow-open-in-explorer",
    "allow-save-notes-export",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
